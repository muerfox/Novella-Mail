# Copy to .env and fill in. Never commit the real .env.
# This one file is read by both services in docker-compose.yml.
# .env is optional: any of these can instead be set in the OS environment
# (exported in the shell, a systemd unit, CI secrets, ...). Compose reads
# this file for ${...} substitution when it exists; a value set in the
# environment wins over the same key here. MAIL_DOMAIN and
# DJANGO_SECRET_KEY are required one way or the other.

# The mail server's own hostname (FQDN) - not a domain you're hosting mail
# for, the server's own identity. See docs/SETUP.md section 2.
MAIL_DOMAIN=mail.example.com
TZ=UTC

# self-signed by default (no public port 80/443 needed to obtain a cert -
# this stack has no web-facing port besides the private panel). See
# docs/SETUP.md section 7 for how to switch to a real cert.
SSL_TYPE=self-signed

# --- Panel ---
# Host port the panel is published on (127.0.0.1 only - put your own
# reverse proxy in front of it, see docs/SETUP.md).
PANEL_PORT=3010

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=changeme-generate-a-real-one
DJANGO_DEBUG=false
# Comma separated. Include whatever host/IP you'll actually reach the panel through.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma separated, e.g. https://mail-panel.yourdomain.com - required if
# you're reaching the panel through your own reverse proxy under a public
# hostname (see novella/settings.py's reverse-proxy section).
CSRF_TRUSTED_ORIGINS=

# Mailbox emails (comma separated) allowed to see and use the panel's
# Domains section. Create the first mailbox with:
#   docker compose exec panel python manage.py createmailbox you@example.com
# then add that address here.
ADMIN_EMAILS=

# The panel talks to the mailserver container directly over the internal
# docker network by default - no need to change these unless you know you
# want something else.
MAIL_IMAP_HOST=mailserver
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mailserver
MAIL_SMTP_PORT=587
# true while SSL_TYPE=self-signed (the default) - disables TLS certificate
# verification on the panel's own IMAP/SMTP connections. Set to false once
# you've switched to a real certificate.
MAIL_TLS_INSECURE=true
