# Copy to .env and fill in. Never commit the real .env.
# (docker-compose.yml reads this same file for both container env vars and
# its own ${PANEL_PORT} substitution.)

# Host port the panel is published on (127.0.0.1 only - see docs/SETUP.md).
PANEL_PORT=3007

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=changeme-generate-a-real-one
DJANGO_DEBUG=false
# Comma separated. Include whatever host/IP you'll actually reach the panel through.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Mail server the panel talks to as an IMAP/SMTP client (same as MAILCOW_HOSTNAME).
MAIL_IMAP_HOST=mail.example.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=mail.example.com
MAIL_SMTP_PORT=587

# Set to true ONLY while the mail server is still using the mailcow self-signed
# "snake oil" cert (see docs/SETUP.md section 7). Turn this off once you've set
# up a trusted cert (DNS-01) - it disables TLS certificate verification.
MAIL_TLS_INSECURE=false

# --- Domain admin (self-service domain onboarding, "Domains" section) ---
# Mailbox emails (comma separated) allowed to see and use the Domains
# section. Must be an email of a mailbox that already exists - create your
# first mailbox via the mailcow admin UI (127.0.0.1:3006), log into the
# panel with it, then add it here and restart the panel container.
ADMIN_EMAILS=

# Filled in automatically by setup.sh - reaches mailcow's API over the
# internal docker network (see docker-compose.yml), never the public
# internet.
MAILCOW_API_BASE_URL=http://nginx:3006
MAILCOW_API_KEY=
MAILCOW_HOSTNAME=mail.example.com

# Also filled in automatically: the docker network name mailcow-dockerized's
# compose stack created, so this panel can join it (see docker-compose.yml).
MAILCOW_NETWORK_NAME=mailcowdockerized_mailcow-network
